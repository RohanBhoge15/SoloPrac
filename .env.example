# SoloPrac AI - Environment Configuration Template
# Copy this file to .env and fill in your values

# ==========================================
# APPLICATION SETTINGS
# ==========================================
# DEBUG=true enables local-testing conveniences: the /docs & /redoc API pages,
# and the dev-login endpoints (POST /api/v1/auth/dev-login for a demo doctor,
# POST /api/v1/public/auth/dev-login for a demo patient) that bypass auth.
# The frontend "Dev login" buttons only appear in a dev build.
# MUST be false in production — dev login would let anyone in.
DEBUG=true
APP_NAME=SoloPrac AI
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# ==========================================
# DATABASE (PostgreSQL + PostGIS)
# ==========================================
POSTGRES_USER=soloprac
POSTGRES_PASSWORD=soloprac_dev_password_change_me
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=soloprac

# ==========================================
# REDIS
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ==========================================
# QDRANT VECTOR DATABASE
# ==========================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ==========================================
# AUTHENTICATION (JWT)
# ==========================================
JWT_SECRET_KEY=changeme_generate_strong_secret_32_chars_min
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# ==========================================
# ABDM SANDBOX (Doctor Verification)
# ==========================================
# Register at https://sandbox.abdm.gov.in → apply for sandbox integration
# Select HPR (Healthcare Professionals Registry) as integration module
# You'll get clientId and clientSecret via email
ABDM_CLIENT_ID=your_abdm_sandbox_client_id
ABDM_CLIENT_SECRET=your_abdm_sandbox_client_secret
ABDM_BASE_URL=https://abdm.gov.in

# NMC / State Medical Council Verification
# Leave empty to skip real verification (used for localhost testing)
NMC_API_URL=
NMC_API_KEY=

# ==========================================
# LLM API KEYS (Free Tier)
# ==========================================
# NVIDIA NIM - Get from https://build.nvidia.com
NIM_API_KEY=your_nim_api_key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
MAVERICK_MODEL=nvidia/llama-4-maverick-17b-128e-instruct
LLAMA_8B_MODEL=nvidia/llama-3.1-8b-instruct
BIOMEDCLIP_MODEL=microsoft/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224

# Groq - Get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
VISION_MODEL=google/medgemma-4b-it

# Local Model Paths (for RTX 3050 GPU)
MEDGEMMA_PATH=/models/medgemma-4b-it
WHISPER_PATH=/models/faster-whisper-large-v3
INDIC_WHISPER_PATH=/models/indic-whisper
PARLER_TTS_PATH=/models/indic-parler-tts

# ==========================================
# EMAIL (SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=SoloPrac AI <noreply@soloprac.ai>

# ==========================================
# ENCRYPTION
# ==========================================
ENCRYPTION_KEY=generate_32_byte_hex_key_for_pgcrypto

# ==========================================
# CADDY / HTTPS
# ==========================================
DOMAIN=localhost
ACME_EMAIL=admin@soloprac.ai

# ==========================================
# LANGFUSE (Observability)
# ==========================================
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_SALT=your_langfuse_salt

# ==========================================
# FRONTEND URL (CORS)
# ==========================================
FRONTEND_URL=http://localhost:5173

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_DEFAULT=100/minute

# ==========================================
# VITE (Frontend)
# ==========================================
VITE_API_BASE=http://localhost:8000/api/v1
VITE_SENTRY_DSN=

# ==========================================
# SENTRY ERROR TRACKING (Free: 5k errors/month)
# ==========================================
SENTRY_DSN=