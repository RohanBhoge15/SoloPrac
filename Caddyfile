# SoloPrac AI - Caddyfile
# Auto HTTPS via Let's Encrypt

# Development (no HTTPS)
localhost {
    # API — use `handle` (not handle_path) to preserve the /api prefix
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Langfuse
    handle /langfuse/* {
        reverse_proxy langfuse:3000
    }

    # Qdrant (if needed externally)
    handle /qdrant/* {
        reverse_proxy qdrant:6333
    }

    # Health checks (no auth)
    handle /health/* {
        reverse_proxy backend:8000
    }
    handle /health {
        reverse_proxy backend:8000
    }

    # Frontend (catch-all)
    handle {
        reverse_proxy frontend:5173
    }
}